# testing
/play-frontend/coverage

# next.js
/play-frontend/.next/
/play-frontend/out/
/play-frontend/tsconfig.tsbuildinfo

# production
/play-frontend/build

# misc
/play-frontend/.DS_Store
/play-frontend/*.pem

# debug
/play-frontend/npm-debug.log*
/play-frontend/yarn-debug.log*
